  "fixed_sql": [
    {
      "name": "todos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"todos\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"type\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"category_id\" TEXT NULL, \"date\" TEXT NULL, \"original_date\" TEXT NULL, \"repeat_weekdays\" INTEGER NULL, \"start_date\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "checklist_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"checklist_items\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"todo_id\" INTEGER NOT NULL REFERENCES todos (id), \"title\" TEXT NOT NULL, \"checked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"checked\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "todo_occurrences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"todo_occurrences\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"todo_id\" INTEGER NOT NULL REFERENCES todos (id), \"date\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"completed_at\" INTEGER NULL, UNIQUE (\"todo_id\", \"date\"));"
        }
      ]
    },
    {
      "name": "point_history",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"point_history\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"amount\" INTEGER NOT NULL, \"reason\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"occurrence_id\" INTEGER NULL REFERENCES todo_occurrences (id), \"item_id\" TEXT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "pets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"species_id\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"stage\" INTEGER NOT NULL DEFAULT 1, \"exp\" INTEGER NOT NULL DEFAULT 0, \"mood\" INTEGER NOT NULL, \"hunger\" INTEGER NOT NULL, \"last_updated_at\" INTEGER NOT NULL, \"tap_count\" INTEGER NOT NULL DEFAULT 0, \"tap_date\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "user_profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_profile\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"active_pet_id\" INTEGER NULL REFERENCES pets (id), \"last_processed_date\" TEXT NULL, \"onboarding_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_done\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
